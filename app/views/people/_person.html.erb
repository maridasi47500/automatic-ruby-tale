<div id="<%= dom_id person %>">
  <div>
    <strong>Type:</strong>
    <%= person.type %>
  </div>

  <div>
    <strong>Name:</strong>
    <%= person.name %>
  </div>

  <div>
    <strong>Age:</strong>
    <%= person.age %>
  </div>

  <div>
    <strong>Gender:</strong>
    <%= person.gender %>
  </div>

  <div>
    <strong>Mood:</strong>
    <%= person.mood %>
  </div>

</div>
